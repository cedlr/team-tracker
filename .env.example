# Auth.js session secret. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Upstash Redis (Vercel Marketplace sets these; older Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN also work).
# Leave both empty in local dev to use the ./.data/kv.json fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Arc Pro registry token, only needed to install or update @uiarc-pro items with the shadcn CLI. Never commit it.
ARC_PRO_TOKEN=
